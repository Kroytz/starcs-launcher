{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STAR Launcher",
  "version": "0.1.0",
  "identifier": "com.star.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "STAR Launcher",
        "width": 1180,
        "height": 960,
        "minWidth": 960,
        "minHeight": 720,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset:",
        "connect-src": "ipc: http://ipc.localhost https://ipc.localhost",
        "font-src": "'self' asset:",
        "img-src": "'self' asset: data: blob: https://static.starcs.cn https://*.starcs.cn https://starcs.cn",
        "style-src": "'unsafe-inline' 'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self' 'unsafe-inline' 'unsafe-eval' http://localhost:1420 ws://localhost:1420 asset: ipc: http://ipc.localhost https://ipc.localhost data: blob:",
        "connect-src": "'self' http://localhost:1420 ws://localhost:1420 ipc: http://ipc.localhost https://ipc.localhost",
        "img-src": "'self' asset: data: blob: http://localhost:1420 https:",
        "style-src": "'unsafe-inline' 'self'",
        "font-src": "'self' asset: data:",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "vendor/steam_api64.dll": "steam_api64.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4N0U0RDEyRThFMEQ2MzEKUldReDF1RG9FazErU0hnTDVWczVoTGNEeDZmOXVoWWJvcmZ2aUo1eTJFZlIzUXFMM2IxMHVVaWkK",
      "endpoints": [
        "http://110.42.9.56:8088/api/v1/launcher/manifest?target={{target}}&arch={{arch}}&current_version={{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      },
      "dangerousInsecureTransportProtocol": true
    }
  }
}
